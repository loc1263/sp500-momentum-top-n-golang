---
// ETFs por gestora: resumen, filtros (gestora, categoría, solo con score) y tabla ordenable y paginada por table.js.
// Fecha: 2026-11-27
import Layout from '../layouts/Layout.astro';
import Missing from '../components/Missing.astro';
import Rows from '../components/Rows.astro';
import Ths from '../components/Ths.astro';
import TableScripts from '../components/TableScripts.astro';
import data from '../data/etfq.json';

const b = data.Body;
---
<Layout shell={data}>
  {data.Page === 'missing' ? <Missing msg={b} /> : (
  <Fragment>
  <p class="range overview">
    <strong>Datos al cierre del</strong> {b.Overview.AsOf} ·
    <strong>ETFs listados</strong> {b.Overview.Listed} <span class="muted">(de {b.Overview.IssuerCount} gestoras)</span> ·
    <strong>Con score final</strong> {b.Overview.Scored} <span class="muted">({b.Overview.Excluded} fuera por TER o AUM)</span> ·
    <strong>Filtro de elegibilidad</strong> {b.Overview.Eligibility}
    {b.Overview.RiskFree && <Fragment> · <strong>Referencia sin riesgo</strong> {b.Overview.RiskFree} <span class="muted">(su retorno se resta al de cada ETF)</span></Fragment>}
  </p>

  <h2>ETFs por gestora</h2>
  <p class="sub wide">{b.Intro}</p>

  <div class="wrap summary">
    <table>
      <thead><tr><th>Gestora</th><th class="r">ETFs listados</th><th class="r">Con momentum</th><th class="r">Con score final</th></tr></thead>
      <tbody>
        {b.Issuers.map((i) => <tr><td><strong>{i.name}</strong></td><td class="r">{i.funds}</td><td class="r">{i.ranked}</td><td class="r">{i.scored}</td></tr>)}
      </tbody>
    </table>
  </div>

  <div data-table data-page-size="12">
    <div class="tfilters">
      <label>Gestora
        <select data-filter="issuer"><option value="">Todas</option>{b.IssuerNames.map((n) => <option>{n}</option>)}</select>
      </label>
      <label>Categoría
        <select data-filter="category"><option value="">Todas</option>{b.Categories.map((n) => <option>{n}</option>)}</select>
      </label>
      <label class="check"><input type="checkbox" data-filter-bool="scored" checked> Solo con score final</label>
      <span class="muted" data-count></span>
    </div>
    <div class="wrap">
      <table>
        <thead><tr><Ths cols={b.Cols} /></tr></thead>
        <tbody><Rows rows={b.Rows} />
          <tr class="empty" hidden><td colspan={b.ColSpan} class="muted">Ningún ETF cumple el filtro.</td></tr>
        </tbody>
      </table>
    </div>
    <nav class="pager" aria-label="Paginación de la tabla" hidden></nav>
  </div>
  <p class="muted note">{b.NotRanked} ETFs más quedaron fuera por no tener historia suficiente para el plazo más largo, tener huecos de precios o ser de tipo efectivo. TER y AUM son los que informa Yahoo Finance hoy.</p>
  </Fragment>
  )}
  <TableScripts />
</Layout>
