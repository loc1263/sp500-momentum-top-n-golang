---
// Lab · backtest: Alpine lo pinta con la página del universo y período elegidos en lab-datos.js (scripts/lab.js).
// Fecha: 2026-11-27
import Layout from '../layouts/Layout.astro';
import Missing from '../components/Missing.astro';
import LabBar from '../components/LabBar.astro';
import LabRange from '../components/LabRange.astro';
import LabRows from '../components/LabRows.astro';
import LabChart from '../components/LabChart.astro';
import data from '../data/lab-backtest.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout shell={data}>
  <Fragment slot="head">{data.Page !== 'missing' && <script is:inline defer src={`${base}lab-datos.js`}></script>}</Fragment>
  {data.Page === 'missing' ? <Missing msg={data.Body} /> : (
  <Fragment>
<div x-data="lab('backtest')" x-cloak>
  <template x-if="!p"><p class="muted" x-text="loaded ? 'No hay datos del Lab. Ejecute topwx backtest (en backend/).' : 'Cargando…'"></p></template>
  <template x-if="p">
    <div>
      <LabBar />
      <div class="toolbar">
        <label>Plazo
          <select @change="term = Number($event.target.value)"><template x-for="t in p.Terms"><option :value="t.Months" :selected="t.Months === term" x-text="t.Months + ' meses'"></option></template></select>
        </label>
      </div>
      <template x-for="t in p.Terms" :key="t.Months">
        <section x-show="t.Months === term">
          <p class="sub" x-text="t.Sub"></p>
          <p class="range overview">
            <strong>Capital inicial</strong> US$ <span x-text="t.Cap0"></span> ·
            <strong>Capital final</strong> US$ <span x-text="t.Cap1"></span> <span class="muted">(empezando en <span x-text="t.First"></span>)</span> ·
            <strong>Ganancia total</strong> <span :class="t.TotalClass" x-text="t.Total"></span> ·
            <strong>Rendimiento anual</strong> <span :class="t.CAGRClass" x-text="t.CAGR"></span> <span class="muted">(CAGR, mismo arranque)</span> ·
            <strong>Resultado típico</strong> <span :class="t.MedianClass" x-text="t.Median + ' anual'"></span> <span class="muted">(el del medio entre <span x-text="t.Calendars"></span> fechas de arranque posibles)</span> ·
            <strong>Según el mes de arranque</strong> <span x-text="t.Min + ' a ' + t.Max"></span> <span class="muted">anual, del peor al mejor</span>
          </p>

          <h2>Curva de capital</h2>
          <LabRange r="t.Range1" />
          <p class="sub">En gris, los demás calendarios de arranque posibles del mismo plazo.</p>
          <LabChart chart="t.Chart" />

          <h2>Historial de selecciones (calendario base)</h2>
          <LabRange r="t.Range2" />
          <p class="sub">Capital = valor al entrar a los tickers de la fila. Gan/Pérd = acumulado vs. capital inicial.</p>
          <div class="wrap">
            <table>
              <thead>
                <tr><th>Fecha</th><template x-for="h in t.HistHeads"><th x-text="'#' + h"></th></template><th class="r">Capital (US$)</th><th class="r">Ganancia acumulada</th></tr>
              </thead>
              <tbody><LabRows rows="t.History" /></tbody>
            </table>
          </div>

          <h2>Calendarios de arranque posibles (<span x-text="t.CalCount"></span>)</h2>
          <LabRange r="t.Range3" />
          <p class="sub" x-text="'El mismo plazo de ' + t.Months + ' meses empezando en cada uno de los ' + t.Months + ' meses posibles.'"></p>
          <div class="wrap">
            <table>
              <thead>
                <tr><th>Desde</th><th>Hasta</th><th>Primer rebalanceo</th><th class="r">Rebalanceos</th><th class="r">Capital final (US$)</th><th class="r">Ganancia total</th><th class="r">Rendimiento anual</th></tr>
              </thead>
              <tbody><LabRows rows="t.CalRows" /></tbody>
            </table>
          </div>
        </section>
      </template>
    </div>
  </template>
</div>
  </Fragment>
  )}
</Layout>
