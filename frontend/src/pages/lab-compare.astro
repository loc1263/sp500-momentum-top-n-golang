---
// Lab · compare: Alpine lo pinta con la página del universo y período elegidos en lab/<vista>/<clave>.json (scripts/lab.js).
// Fecha: 2026-11-27
import Layout from '../layouts/Layout.astro';
import Missing from '../components/Missing.astro';
import LabBar from '../components/LabBar.astro';
import LabRange from '../components/LabRange.astro';
import LabRows from '../components/LabRows.astro';
import LabChart from '../components/LabChart.astro';
import data from '../data/lab-compare.json';
---
<Layout shell={data}>
  {data.Page === 'missing' ? <Missing msg={data.Body} /> : (
  <Fragment>
<div x-data="lab('compare')" x-cloak>
  <template x-if="!p"><p class="muted" x-text="loaded ? 'No hay datos del Lab. Ejecute topwx backtest (en backend/).' : 'Cargando…'"></p></template>
  <template x-if="p">
    <div>
      <LabBar />
      <template x-if="p.Empty">
        <p class="muted">Sin resultados del modelo skip-month para este universo y período. Ejecute topwx backtest --sweep (en backend/).</p>
      </template>
      <template x-if="!p.Empty">
        <div>
          <div class="best">
            <p class="line"><strong x-text="p.Headline"></strong> Diferencia media del resultado típico (N-1 menos N-0): <strong :class="p.AvgClass" x-text="p.AvgDiff + ' anual'"></strong>.</p>
            <p class="line muted">N-0 ordena por lo que subió cada acción en los últimos N meses; N-1 ignora el último mes para no premiar rebotes de corto plazo. Mismos datos, arranques y universo.</p>
          </div>

          <h2>Plazo por plazo</h2>
          <LabRange r="p.Range1" />
          <div class="wrap">
            <table>
              <thead>
                <tr class="groups">
                  <th></th><th colspan="2" class="typical">Resultado típico (anual)</th><th></th><th colspan="2">Peor / mejor arranque</th><th colspan="2">Capital final típico</th><th></th>
                </tr>
                <tr>
                  <th>Plazo</th><th class="r typical">N-0</th><th class="r typical">N-1</th><th class="r">Diferencia</th>
                  <th class="r">N-0</th><th class="r">N-1</th><th class="r">N-0</th><th class="r">N-1</th><th>Gana</th>
                </tr>
              </thead>
              <tbody><LabRows rows="p.Rows" /></tbody>
            </table>
          </div>
          <p class="sub note" x-text="'«Típico» = mediana de los arranques posibles, con US$ ' + p.Capital + ' iniciales. Una diferencia pequeña en «Gana» no prueba que un modelo sea mejor.'"></p>

          <template x-if="p.HasHalves">
            <div>
              <h2>¿Se sostiene en el tiempo?</h2>
              <LabRange r="p.Range1" />
              <p class="sub">El período se parte en dos mitades (corte cerca del <span x-text="p.Split"></span>). Si un modelo gana en las dos, su ventaja no depende de un solo tramo del mercado. <strong x-text="p.HalvesText"></strong></p>
              <div class="wrap">
                <table>
                  <thead>
                    <tr class="groups"><th></th><th colspan="3">Primera mitad (anual)</th><th colspan="3">Segunda mitad (anual)</th><th></th></tr>
                    <tr><th>Plazo</th><th class="r">N-0</th><th class="r">N-1</th><th>Gana</th><th class="r">N-0</th><th class="r">N-1</th><th>Gana</th><th>Se sostiene</th></tr>
                  </thead>
                  <tbody><LabRows rows="p.HalfRows" /></tbody>
                </table>
              </div>
              <p class="sub note">Con períodos cortos cada mitad tiene pocos rebalanceos: mejor mirar 6 años o más.</p>
            </div>
          </template>

          <h2>Evolución del capital</h2>
          <div class="toolbar">
            <label>Plazo
              <select @change="cterm = Number($event.target.value)"><template x-for="c in p.Charts"><option :value="c.Months" :selected="c.Months === cterm" x-text="c.Months + ' meses'"></option></template></select>
            </label>
          </div>
          <p class="sub">Arranque base de cada modelo (un solo caso por modelo), no el promedio.</p>
          <template x-for="c in p.Charts" :key="c.Months">
            <div x-show="c.Months === cterm" x-html="c.Chart" x-effect="initCharts($el, c.Chart)"></div>
          </template>
        </div>
      </template>
    </div>
  </template>
</div>
  </Fragment>
  )}
</Layout>
