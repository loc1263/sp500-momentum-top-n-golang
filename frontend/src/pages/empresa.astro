---
// Detalle de una empresa del evaluador: una sola página para todas. scripts/empresa.js lee el ticker del hash (empresa.html#AAPL) y
// Alpine pinta las métricas, minigráficos y pares a partir de empresas/<TICKER>.json (datos ya formateados por Go).
// Fecha: 2026-11-27
import Layout from '../layouts/Layout.astro';
import data from '../data/empresa.json';
---
<Layout shell={data}>
<div x-data="empresa" x-cloak>
  <template x-if="!c">
    <div class="head">
      <a class="btn back" href="evaluador.html">← Volver al listado</a>
      <p class="muted" x-text="loaded ? 'No hay datos de esa empresa en el evaluador.' : 'Cargando…'"></p>
    </div>
  </template>

  <template x-if="c">
    <div>
      <div class="head">
        <a class="btn back" href="evaluador.html">← Volver al listado</a>
        <h3>
          <a :href="c.TickerHref" target="_blank" rel="noopener noreferrer" :title="'Ver ' + c.Ticker + ' en stockanalysis.com'"><strong x-text="c.Ticker"></strong></a>
          <span class="name" x-text="c.Name"></span>
          <span class="pill" :class="c.Verdict.Level" x-text="c.Verdict.Text"></span>
        </h3>
        <p class="muted facts" x-text="c.Facts"></p>
        <template x-if="c.Bank">
          <p class="muted">Banco o aseguradora: su deuda y su caja son materia prima del negocio, así que caja, deuda y liquidez no se evalúan.</p>
        </template>
      </div>

      <div class="grid">
        <template x-for="s in c.Sections" :key="s.ID">
          <section class="sec" :class="{ wide: s.Wide }" :aria-labelledby="'sec-' + s.ID">
            <div class="sec-h">
              <h4 :id="'sec-' + s.ID"><span x-text="s.Title"></span> <span class="hint" tabindex="0" role="img" :aria-label="s.Why" :title="s.Why">?</span></h4>
              <span class="pill" :class="s.Pill.Level" x-text="s.Pill.Text"></span>
            </div>

            <template x-if="s.Kind === 'peers'">
              <div>
                <p class="muted intro" x-text="s.Intro"></p>
                <div class="wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Métrica</th><th class="r" x-text="s.Peers.Ticker"></th>
                        <template x-for="h in s.Peers.Heads"><th class="r" :title="h.Name" x-text="h.Ticker"></th></template>
                        <th class="r">Mediana</th><th>Vs.</th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="r in s.Peers.Rows">
                        <tr>
                          <td><span x-text="r.Name"></span> <span class="hint" tabindex="0" role="img" :aria-label="r.Why" :title="r.Why">?</span></td>
                          <td class="r me" :class="{ best: r.MineBest }" x-text="r.Mine"></td>
                          <template x-for="v in r.Values"><td class="r" :class="{ best: v.Best }" x-text="v.Text"></td></template>
                          <td class="r" x-text="r.Median"></td>
                          <td><span class="pill" :class="r.Pill.Level" x-text="r.Pill.Text"></span></td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </div>
              </div>
            </template>

            <template x-if="s.Kind === 'peers-none'">
              <p class="muted">No hay otras empresas de la misma industria o sector en este mercado para comparar.</p>
            </template>

            <template x-if="s.Kind === 'empty'">
              <p class="muted">Sin datos suficientes de Yahoo Finance.</p>
            </template>

            <template x-if="s.Kind === 'metrics' && s.ID === 'trend'">
              <div class="mcards">
                <template x-for="m in s.Metrics">
                  <article class="mcard">
                    <div class="mcard-h">
                      <span class="mname"><span x-text="m.Name"></span> <span class="hint" tabindex="0" role="img" :aria-label="m.Why" :title="m.Why">?</span></span>
                      <span class="pill" :class="m.Pill.Level" x-text="m.Pill.Text"></span>
                    </div>
                    <div class="mval" x-text="m.Value"></div>
                    <template x-if="m.Spark"><div x-html="m.Spark"></div></template>
                    <template x-if="m.Note"><p class="note muted" x-text="m.Note"></p></template>
                  </article>
                </template>
              </div>
            </template>

            <template x-if="s.Kind === 'metrics' && s.ID !== 'trend'">
              <ul class="rows">
                <template x-for="m in s.Metrics">
                  <li>
                    <div class="row">
                      <span class="mname"><span x-text="m.Name"></span> <span class="hint" tabindex="0" role="img" :aria-label="m.Why" :title="m.Why">?</span></span>
                      <span class="mval" x-text="m.Value"></span>
                      <span class="pill" :class="m.Pill.Level" x-text="m.Pill.Text"></span>
                    </div>
                    <template x-if="m.Spark"><div x-html="m.Spark"></div></template>
                    <template x-if="m.HasRange">
                      <div class="rng" role="img" :aria-label="'De ' + m.Lo + ' a ' + m.Hi">
                        <div class="track"><span class="dot" :style="'left:' + m.Left + '%'"></span></div>
                        <div class="lbls"><span x-text="m.Lo"></span><span x-text="m.Hi"></span></div>
                      </div>
                    </template>
                    <template x-if="m.Note"><p class="note muted" x-text="m.Note"></p></template>
                  </li>
                </template>
              </ul>
            </template>
          </section>
        </template>
      </div>

      <template x-if="c.Flows">
        <div class="flows">
          <div class="flows-h">
            <h3>Estados financieros en diagramas</h3>
            <label>Ejercicio
              <select x-model.number="fy"><template x-for="(y, i) in c.Flows.Years" :key="y.Date"><option :value="i" :selected="i === fy" x-text="y.Label + ' · cierre ' + y.Date"></option></template></select>
            </label>
          </div>

          <section class="flow-card" aria-labelledby="flow-income">
            <h4 id="flow-income" x-text="'¿Cómo gana dinero ' + c.Name + '?'"></h4>
            <p class="muted intro">Recorre cada dólar de ingresos por el estado de resultados: costo de ventas, gastos operativos e impuestos, hasta lo que queda como utilidad.</p>
            <template x-if="year.Income"><div class="sankey" x-html="year.Income"></div></template>
            <template x-if="!year.Income"><p class="muted" x-text="year.IncomeNote"></p></template>
          </section>

          <section class="flow-card" aria-labelledby="flow-cash">
            <h4 id="flow-cash" x-text="'¿A dónde va la caja de ' + c.Name + '?'"></h4>
            <p class="muted intro">Parte de la utilidad neta y los ajustes sin efectivo, pasa por el flujo operativo y llega a CapEx, flujo libre, recompras, dividendos, pago de deuda y caja retenida.</p>
            <template x-if="year.Cash"><div class="sankey" x-html="year.Cash"></div></template>
            <template x-if="!year.Cash"><p class="muted" x-text="year.CashNote"></p></template>
          </section>

          <p class="muted note" x-text="'Cifras en ' + c.Flows.Currency + ', anuales, de Yahoo Finance. Los porcentajes son parte de los ingresos (primer diagrama) o del flujo operativo (segundo). Las partidas que la empresa no desglosa se derivan de las demás para que los flujos cuadren. Solo informativo.'"></p>
        </div>
      </template>
    </div>
  </template>
</div>
</Layout>
